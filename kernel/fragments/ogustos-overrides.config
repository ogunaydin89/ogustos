# ==============================================================================
# ogustOS 7.3.x Kernel Overrides Fragment (Applied on top of Universal Debian Config)
# Built with LLVM=1 + Clang ThinLTO + Cachy + BORE + BBRv3 + Built-In (=y) Hotpaths
# ==============================================================================

# 1. Release Identity, Portable x86_64 Target, Cachy Base & Clang ThinLTO
CONFIG_LOCALVERSION="-ogustOS"
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_WERROR is not set
CONFIG_CACHY=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_GENERIC_CPU=y
# CONFIG_X86_NATIVE_CPU is not set
CONFIG_LTO_CLANG_THIN=y
CONFIG_DEBUG_INFO=y
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_ALL is not set
CONFIG_MODULE_COMPRESS=y
# CONFIG_MODULE_COMPRESS_GZIP is not set
# CONFIG_MODULE_COMPRESS_XZ is not set
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_COMPRESS_ALL=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# 2. Scheduler (BORE + sched_ext + 1000 Hz + Full Preemption + High-Res Tick + Idle Tickless)
CONFIG_SCHED_BORE=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_NO_HZ_COMMON=y
# CONFIG_HZ_PERIODIC is not set
CONFIG_NO_HZ_IDLE=y
# CONFIG_NO_HZ_FULL is not set
# CONFIG_NO_HZ is not set
CONFIG_TICK_CPU_ACCOUNTING=y
# CONFIG_VIRT_CPU_ACCOUNTING_GEN is not set
# CONFIG_CONTEXT_TRACKING_USER is not set
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_PREEMPT_BUILD=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_COUNT=y
CONFIG_PREEMPTION=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_SCHED_SMT=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_HRTICK=y
CONFIG_HIGH_RES_TIMERS=y

# 3. Zero-Delay RCU Priority Boosting
CONFIG_PREEMPT_RCU=y
CONFIG_RCU_EXPERT=y
CONFIG_RCU_BOOST=y
CONFIG_RCU_BOOST_DELAY=0

# 4. CPU Frequency Scaling (Both AMD P-State Active & Intel P-State Built-In)
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3
CONFIG_X86_INTEL_PSTATE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# 5. Compile-Time Mitigation Removal (Maximum L1i Cache Efficiency & 1% Lows)
# CONFIG_CPU_MITIGATIONS is not set
# CONFIG_MITIGATION_PAGE_TABLE_ISOLATION is not set
# CONFIG_MITIGATION_RETPOLINE is not set
# CONFIG_MITIGATION_RETHUNK is not set
# CONFIG_MITIGATION_UNRET_ENTRY is not set
# CONFIG_MITIGATION_CALL_DEPTH_TRACKING is not set
# CONFIG_MITIGATION_IBPB_ENTRY is not set
# CONFIG_MITIGATION_IBRS_ENTRY is not set
# CONFIG_MITIGATION_SRSO is not set
# CONFIG_MITIGATION_SLS is not set
# CONFIG_MITIGATION_GDS is not set
# CONFIG_MITIGATION_RFDS is not set
# CONFIG_MITIGATION_SPECTRE_BHI is not set
# CONFIG_MITIGATION_MDS is not set
# CONFIG_MITIGATION_TAA is not set
# CONFIG_MITIGATION_MMIO_STALE_DATA is not set
# CONFIG_MITIGATION_L1TF is not set
# CONFIG_MITIGATION_RETBLEED is not set
# CONFIG_MITIGATION_SPECTRE_V1 is not set
# CONFIG_MITIGATION_SPECTRE_V2 is not set
# CONFIG_MITIGATION_SRBDS is not set
# CONFIG_MITIGATION_SSB is not set

# 6. Built-In (=y) Storage, Filesystem & Memory Hotpaths (For Cross-File ThinLTO)
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NTFS3_FS=m
CONFIG_NTFS3_64BIT_CLUSTER=y
CONFIG_NTFS3_LZX_XPRESS=y
# CONFIG_NTFS3_FS_POSIX_ACL is not set
# CONFIG_NTFS_FS is not set
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_LRU_GEN_WALKS_MMU=y
CONFIG_TRANSPARENT_HUGEPAGE=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_TRANSPARENT_HUGEPAGE_SHMEM_HUGE_NEVER=y
CONFIG_TRANSPARENT_HUGEPAGE_TMPFS_HUGE_NEVER=y
CONFIG_DEFAULT_MMAP_MIN_ADDR=65536
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_DEF_COMP="lz4"

# 7. Gaming & Synchronization (Built-In /dev/ntsync)
CONFIG_NTSYNC=y

# 8. Networking (Google TCP BBRv3 Default + Fair Queueing Built-In)
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=m
CONFIG_TCP_CONG_BBR3=y
CONFIG_DEFAULT_BBR3=y
CONFIG_DEFAULT_TCP_CONG="bbr3"
CONFIG_NET_SCH_FQ=y

# 9. Motherboard Super I/O Sensors
CONFIG_HWMON=y
CONFIG_SENSORS_K10TEMP=m
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_NCT6775=m
CONFIG_SENSORS_NCT6683=m
CONFIG_SENSORS_IT87=m
CONFIG_DRM_PANIC_SCREEN="user"
# CONFIG_INPUT_PCSPKR is not set
# CONFIG_SND_PCSP is not set
# CONFIG_PCSPKR_PLATFORM is not set
