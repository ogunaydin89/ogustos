#!/usr/bin/env bash
# ==============================================================================
# ogust-calamares-postinstall — Target Post-Installation Hook for Calamares
# Invoked by Calamares shellprocess module with ${ROOT} as $1 before umount.
# ==============================================================================
set -euo pipefail

TARGET_MNT="${1:-}"
if [[ -z "$TARGET_MNT" || "$TARGET_MNT" == *"ROOT"* || ! -d "${TARGET_MNT}/lib/modules" ]]; then
    TARGET_MNT="$(findmnt -rn -o TARGET | grep -E '^/tmp/calamares-root-' | head -n 1 || true)"
fi
if [[ -z "$TARGET_MNT" || ! -d "${TARGET_MNT}/lib/modules" ]]; then
    echo "ERROR: Could not locate Calamares target root mountpoint (arg='$*')" >&2
    exit 1
fi

LIVE_MNT="/run/live/medium"
for p in /run/live/medium/live/vmlinuz /lib/live/mount/medium/live/vmlinuz; do
    if [[ -f "$p" ]]; then
        LIVE_MNT="${p%/live/vmlinuz}"
        break
    fi
done

KVER="$(ls -1 "${TARGET_MNT}/lib/modules" | sort -V | tail -n 1)"

echo "[::] Installing kernel ${KVER} and metadata to ${TARGET_MNT}/boot..."
mkdir -p "${TARGET_MNT}/boot"
if [[ -f "${LIVE_MNT}/live/vmlinuz" ]]; then
    cp -f --no-preserve=ownership,mode "${LIVE_MNT}/live/vmlinuz" "${TARGET_MNT}/boot/vmlinuz-${KVER}"
elif [[ -f "/boot/vmlinuz-${KVER}" ]]; then
    cp -f --no-preserve=ownership,mode "/boot/vmlinuz-${KVER}" "${TARGET_MNT}/boot/vmlinuz-${KVER}"
fi

for f in "/boot/config-${KVER}" "/boot/System.map-${KVER}"; do
    if [[ -f "$f" ]]; then
        cp -f --no-preserve=ownership,mode "$f" "${TARGET_MNT}/boot/"
    fi
done

if [[ -d /usr/lib/systemd/boot/efi ]]; then
    mkdir -p "${TARGET_MNT}/usr/lib/systemd/boot/efi"
    cp -a /usr/lib/systemd/boot/efi/. "${TARGET_MNT}/usr/lib/systemd/boot/efi/"
fi

# Remove live installer systemd unit from installed system
rm -f "${TARGET_MNT}/etc/systemd/system/ogust-installer.service" \
      "${TARGET_MNT}/etc/systemd/system/multi-user.target.wants/ogust-installer.service"

# Ensure /etc/hostname, /etc/hosts, and /etc/sudoers.d/10-installer are populated
if [[ ! -s "${TARGET_MNT}/etc/hostname" ]]; then
    echo "ogustos" > "${TARGET_MNT}/etc/hostname"
fi
TARGET_HOSTNAME="$(tr -d '[:space:]' < "${TARGET_MNT}/etc/hostname")"
if ! grep -q "127.0.1.1" "${TARGET_MNT}/etc/hosts" 2>/dev/null; then
    cat > "${TARGET_MNT}/etc/hosts" <<EOF
127.0.0.1	localhost
127.0.1.1	${TARGET_HOSTNAME}
::1		localhost ip6-localhost ip6-loopback
ff02::1		ip6-allnodes
ff02::2		ip6-allrouters
EOF
fi
mkdir -p "${TARGET_MNT}/etc/sudoers.d"
if [[ ! -s "${TARGET_MNT}/etc/sudoers.d/10-installer" ]]; then
    echo "%sudo ALL=(ALL:ALL) ALL" > "${TARGET_MNT}/etc/sudoers.d/10-installer"
fi
chmod 0440 "${TARGET_MNT}/etc/sudoers.d/10-installer"

# Sync keyboard layout selected in Calamares to KDE Plasma Wayland (kxkbrc) and ensure /bin/zsh for new users
XKB_LAYOUT="tr"
XKB_VARIANT=""
if [[ -f "${TARGET_MNT}/etc/default/keyboard" ]]; then
    # shellcheck disable=SC1090
    source "${TARGET_MNT}/etc/default/keyboard" || true
    XKB_LAYOUT="${XKBLAYOUT:-tr}"
    XKB_VARIANT="${XKBVARIANT:-}"
fi

mkdir -p "${TARGET_MNT}/etc/skel/.config"
cat > "${TARGET_MNT}/etc/skel/.config/kxkbrc" <<EOF
[Layout]
LayoutList=${XKB_LAYOUT}
VariantList=${XKB_VARIANT}
Use=true
EOF

for user_home in "${TARGET_MNT}"/home/*; do
    [[ -d "$user_home" ]] || continue
    user_name="${user_home##*/}"
    if [[ ! -f "${user_home}/.zshrc" && -f "${TARGET_MNT}/etc/skel/.zshrc" ]]; then
        cp -a "${TARGET_MNT}/etc/skel/." "${user_home}/"
    fi
    mkdir -p "${user_home}/.config"
    cat > "${user_home}/.config/kxkbrc" <<EOF
[Layout]
LayoutList=${XKB_LAYOUT}
VariantList=${XKB_VARIANT}
Use=true
EOF
    chroot "$TARGET_MNT" usermod -s /bin/zsh "$user_name" 2>/dev/null || true
    owner_ug="$(stat -c '%u:%g' "$user_home")"
    chown -R "$owner_ug" "$user_home"
done

# Sync hardware clock to LOCAL if Windows Boot Manager is present on EFI partition
if [[ -f "${TARGET_MNT}/boot/EFI/Microsoft/Boot/bootmgfw.efi" || -f "${TARGET_MNT}/boot/efi/EFI/Microsoft/Boot/bootmgfw.efi" ]]; then
    cat > "${TARGET_MNT}/etc/adjtime" <<'EOF'
0.0 0.0 0.0
0
LOCAL
EOF
fi

# Run target chroot tasks: enable UFW, purge live/installer packages, build initramfs, install systemd-boot
chroot "$TARGET_MNT" /usr/bin/env -i HOME=/root TERM=xterm PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C.UTF-8 KVER="$KVER" /bin/bash -e <<'EOF'
printf "#!/bin/sh\nexit 101\n" > /usr/sbin/policy-rc.d
chmod 0755 /usr/sbin/policy-rc.d

if command -v ufw >/dev/null 2>&1; then
    ufw default deny incoming || true
    ufw default allow outgoing || true
    sed -i 's/^ENABLED=no/ENABLED=yes/' /etc/ufw/ufw.conf 2>/dev/null || true
fi

# Purge live-boot and Calamares installer packages from the installed OS
dpkg --purge --no-triggers \
    live-boot live-boot-initramfs-tools \
    calamares os-prober grub-common grub2-common 2>/dev/null || true
rm -rf /etc/calamares /usr/sbin/policy-rc.d

# Build clean target initramfs once (with config-7.3.0-ogustOS present in /boot)
update-initramfs -c -k "$KVER"

# Install systemd-boot into /boot (or /boot/efi if separate)
if mountpoint -q /boot/efi; then
    bootctl --esp-path=/boot/efi --boot-path=/boot install || bootctl --esp-path=/boot/efi --boot-path=/boot --no-variables install || true
    mkdir -p /boot/efi/EFI/BOOT /boot/efi/EFI/systemd
    cp -f --no-preserve=ownership,mode /usr/lib/systemd/boot/efi/systemd-bootx64.efi /boot/efi/EFI/BOOT/BOOTX64.EFI
    cp -f --no-preserve=ownership,mode /usr/lib/systemd/boot/efi/systemd-bootx64.efi /boot/efi/EFI/systemd/systemd-bootx64.efi
else
    bootctl --path=/boot install || bootctl --path=/boot --no-variables install || true
    mkdir -p /boot/EFI/BOOT /boot/EFI/systemd
    cp -f --no-preserve=ownership,mode /usr/lib/systemd/boot/efi/systemd-bootx64.efi /boot/EFI/BOOT/BOOTX64.EFI
    cp -f --no-preserve=ownership,mode /usr/lib/systemd/boot/efi/systemd-bootx64.efi /boot/EFI/systemd/systemd-bootx64.efi
fi
EOF

# Determine root kernel parameters (UUID, optional LUKS crypttab, optional btrfs subvol)
KERNEL_CMDLINE="amdgpu.gpu_recovery=1 rw quiet"
CHASSIS_TYPE="$(cat /sys/class/dmi/id/chassis_type 2>/dev/null || echo 3)"
case "$CHASSIS_TYPE" in
    8|9|10|11|14|30|31|32) ;;
    *) KERNEL_CMDLINE="${KERNEL_CMDLINE} pcie_aspm.policy=performance" ;;
esac

ROOT_SPEC="$(awk '$2 == "/" && $1 !~ /^#/ {print $1; exit}' "${TARGET_MNT}/etc/fstab")"
ROOT_FSTYPE="$(awk '$2 == "/" && $1 !~ /^#/ {print $3; exit}' "${TARGET_MNT}/etc/fstab")"
ROOT_OPTS="$(awk '$2 == "/" && $1 !~ /^#/ {print $4; exit}' "${TARGET_MNT}/etc/fstab")"

BOOT_ROOT_ARGS=""
if [[ -f "${TARGET_MNT}/etc/crypttab" ]] && grep -qE '^[^#]' "${TARGET_MNT}/etc/crypttab"; then
    CRYPT_NAME="$(awk '$1 !~ /^#/ && NF >= 2 {print $1; exit}' "${TARGET_MNT}/etc/crypttab")"
    CRYPT_SRC="$(awk '$1 !~ /^#/ && NF >= 2 {print $2; exit}' "${TARGET_MNT}/etc/crypttab")"
    BOOT_ROOT_ARGS="cryptdevice=${CRYPT_SRC}:${CRYPT_NAME} root=/dev/mapper/${CRYPT_NAME}"
elif [[ "$ROOT_SPEC" == UUID=* ]]; then
    BOOT_ROOT_ARGS="root=${ROOT_SPEC}"
else
    ROOT_UUID="$(blkid -s UUID -o value "$ROOT_SPEC" 2>/dev/null || true)"
    BOOT_ROOT_ARGS="root=UUID=${ROOT_UUID}"
fi

if [[ "$ROOT_FSTYPE" == "btrfs" ]] && [[ "$ROOT_OPTS" =~ subvol=([^,]+) ]]; then
    BOOT_ROOT_ARGS="${BOOT_ROOT_ARGS} rootflags=subvol=${BASH_REMATCH[1]}"
fi

mkdir -p "${TARGET_MNT}/etc/kernel" "${TARGET_MNT}/boot/loader/entries"
echo "${BOOT_ROOT_ARGS} ${KERNEL_CMDLINE}" > "${TARGET_MNT}/etc/kernel/cmdline"

cat > "${TARGET_MNT}/boot/loader/loader.conf" <<'EOF'
default ogustos.conf
timeout 0
console-mode max
editor no
EOF

cat > "${TARGET_MNT}/boot/loader/entries/ogustos.conf" <<EOF
title   ogustOS KDE (${KVER})
linux   /vmlinuz-${KVER}
initrd  /initrd.img-${KVER}
options ${BOOT_ROOT_ARGS} ${KERNEL_CMDLINE}
EOF

sync
echo "[::] ogust-calamares-postinstall completed cleanly."
