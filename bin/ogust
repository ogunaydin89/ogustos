#!/usr/bin/env bash
# ==============================================================================
# ogust — Unified Package, Version-Catalogue & Source-Build Manager for ogustOS
# Backed by Nala / APT with 3-tier pinning (ogustOS 1001 > Debian 900 > Pardus 100)
# ==============================================================================
set -euo pipefail

FRONTEND="apt"
if command -v nala >/dev/null 2>&1; then
    FRONTEND="nala"
fi

need_root() {
    if [[ $EUID -ne 0 ]]; then
        exec sudo "$0" "$@"
    fi
}

ensure_remote_indexes() {
    if ! compgen -G "/var/lib/apt/lists/*deb.debian.org*_Packages*" >/dev/null; then
        echo "[::] Initializing APT repository package indexes..."
        if [[ $EUID -eq 0 ]]; then
            apt-get update
        else
            sudo apt-get update
        fi
    fi
}

usage() {
    cat <<'EOF'
ogust — ogustOS Package, Version-Catalogue & Source-Build Manager

Usage:
  ogust up                  Sync repositories, full-upgrade, and autoremove orphans
  ogust in <pkg...>         Install package(s) or specific version (e.g. ogust in mesa=25.0.2-1)
  ogust rm <pkg...>         Purge package(s) and clean unused dependencies
  ogust se <query>          Search across ogustOS, Debian, and Pardus repositories
  ogust versions <pkg>      Show full version catalogue & repository priorities for <pkg>
  ogust build [--native] <pkg>
                            Compile <pkg> from source into a .deb (-O2 -pipe -fuse-ld=mold)
  ogust lock <pkg...>       Pin/hold package(s) at their current installed version
  ogust unlock <pkg...>     Release version lock on package(s)
  ogust locks               List all currently version-locked packages
  ogust clean               Clean package cache and vacuum journal logs
EOF
}

cmd="${1:-}"
shift || true

case "$cmd" in
    up|upgrade)
        need_root "$cmd" "$@"
        if [[ "$FRONTEND" == "nala" ]]; then
            nala upgrade --full --autoremove "$@"
        else
            apt update && apt full-upgrade -y "$@" && apt autoremove --purge -y
        fi
        ;;
    in|install|get)
        need_root "$cmd" "$@"
        # If any requested package isn't already in the pre-indexed local repo, ensure remote indexes exist
        for arg in "$@"; do
            [[ "$arg" == -* ]] && continue
            pkg_name="${arg%%=*}"
            if ! apt-cache show "$pkg_name" >/dev/null 2>&1; then
                ensure_remote_indexes
                break
            fi
        done
        "$FRONTEND" install "$@"
        ;;
    rm|remove|purge)
        need_root "$cmd" "$@"
        "$FRONTEND" purge --autoremove "$@"
        ;;
    se|search|s)
        ensure_remote_indexes
        "$FRONTEND" search "$@"
        ;;
    versions|policy|info|eix)
        ensure_remote_indexes
        for pkg in "$@"; do
            echo "=== Version Catalogue for: ${pkg} ==="
            apt-cache madison "$pkg"
            echo ""
            apt-cache policy "$pkg"
        done
        ;;
    build|compile)
        MARCH_FLAGS="-march=x86-64 -mtune=generic"
        if [[ "${1:-}" == "--native" ]]; then
            MARCH_FLAGS="-march=native"
            shift
        fi
        if [[ $# -lt 1 ]]; then
            echo "Usage: ogust build [--native] <package-name>"
            exit 1
        fi
        PKG="$1"
        if [[ ! "$PKG" =~ ^[a-z0-9][a-z0-9+.-]*$ ]]; then
            echo "ERROR: Invalid package name: ${PKG}"
            exit 1
        fi
        BUILD_DIR="/var/tmp/ogustos-build/${PKG}"
        echo "[::] Installing build dependencies for ${PKG}..."
        sudo apt-get update
        sudo apt-get build-dep -y "$PKG"

        mkdir -p "$BUILD_DIR"
        chmod 0755 "$BUILD_DIR"
        cd "$BUILD_DIR"

        export DEB_BUILD_OPTIONS="parallel=$(nproc) nocheck"
        export DEB_CFLAGS_SET="-O2 ${MARCH_FLAGS} -pipe"
        export DEB_CXXFLAGS_SET="-O2 ${MARCH_FLAGS} -pipe"
        export DEB_LDFLAGS_SET="-Wl,-O1 -Wl,--as-needed -fuse-ld=mold"

        echo "[::] Downloading source and compiling ${PKG} (-j$(nproc), ${MARCH_FLAGS}, mold)..."
        apt-get source --compile "$PKG"

        echo "----------------------------------------------------------------"
        echo "[::] Built .deb packages in ${BUILD_DIR}:"
        ls -lh "${BUILD_DIR}"/*.deb
        ;;
    lock|hold)
        need_root "$cmd" "$@"
        apt-mark hold "$@"
        ;;
    unlock|unhold)
        need_root "$cmd" "$@"
        apt-mark unhold "$@"
        ;;
    locks|held)
        apt-mark showhold
        ;;
    clean)
        need_root "$cmd" "$@"
        apt clean
        journalctl --vacuum-size=64M
        ;;
    *)
        usage
        exit 1
        ;;
esac
