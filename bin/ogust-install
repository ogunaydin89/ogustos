#!/usr/bin/env bash
# ==============================================================================
# ogust-install — Standalone KWin Wayland + Calamares Graphical Installer Launcher
# Boots directly into fullscreen Calamares (Breeze Dark, Qt6/KF6 Wayland) on tty1
# ==============================================================================
set -euo pipefail

if [[ -c /dev/tty1 ]]; then
    exec </dev/tty1 >/dev/tty1 2>&1
    chvt 1 2>/dev/null || true
fi

# Pre-open kernel sysrq trigger in RAM so reboot works even if the live USB is unplugged at the end
echo 1 > /proc/sys/kernel/sysrq 2>/dev/null || true
exec 9>/proc/sysrq-trigger 2>/dev/null || true

export HOME=/root
export USER=root
export LOGNAME=root
export XDG_RUNTIME_DIR=/run/user/0
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=KDE
export QT_QPA_PLATFORM=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export KWIN_DRM_NO_AMS=0
export LANG=en_GB.UTF-8

mkdir -p -m 0700 "$XDG_RUNTIME_DIR"
mkdir -p /root/.config

# Apply ogustOS Breeze Dark theme & borderless fullscreen window settings for the installer session
cp -a /etc/skel/.config/. /root/.config/ 2>/dev/null || true
cat > /root/.config/kwinrc <<'EOF'
[Windows]
BorderlessMaximizedWindows=true
Placement=Maximizing

[org.kde.kdecoration2]
ButtonsOnLeft=
ButtonsOnRight=
BorderSize=None
EOF

cat > /root/.config/kxkbrc <<'EOF'
[Layout]
LayoutList=tr
Use=true
EOF

# Launch standalone KWin Wayland compositor hosting Calamares
dbus-run-session -- kwin_wayland --no-lockscreen --xwayland --exit-with-session "/bin/sh -c 'setxkbmap -model pc105 -layout tr 2>/dev/null || true; exec /usr/bin/calamares -D6'" || true

sync
printf 'b\n' >&9 2>/dev/null || systemctl reboot -i
